# Local firmware secrets.
firmware/config.toml
# 旧方式ではsecretをRustソースへ置いていたため、残っていてもGitへ入れない。
firmware/src/config.rs
firmware/src/_config.rs

# m5stack-pc-bridge (Windows側) local secrets.
m5stack-pc-bridge/config.toml

# Rust generated files.
target/
m5stack-pc-bridge/target/
# shared/はlibraryなのでlockfileはコミットしない。
# firmware/bridge側から直接cargoを叩くと生成される。
shared/*/Cargo.lock

# esp-idf / embuild generated files (Rust firmware).
firmware/.embuild/
firmware/.nvs-provisioning/
firmware/sdkconfig
firmware/managed_components/
firmware/dependencies.lock

# scripts/package-firmware.sh が作るOTA配信用イメージ。build成果物なのでcommitしない。
firmware/dist/

# flash/NVSダンプはWi-FiパスワードやHMAC secretを平文で含むため、誤add防止で無視する。
*.bin

# Local env and secret files.
.env
.env.*
*secret*.json
*credential*.json
*service-account*.json
*.key
*.pem

# Local caches and logs.
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
*.log
docs/tasks/
