# M5Stack Core2 for AWS is a plain ESP32 (not S3), 16MB flash, with PSRAM.
# Unlike the upstream m5unified-rs examples (which target ESP32-S3 and its
# native USB-Serial-JTAG console), this board uses a CP2104 USB-UART bridge,
# so the default UART console is left enabled instead of being overridden.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y

# OTA(無線更新)対応。partitions.csv でota_0/ota_1/otadataを定義している(Issue #41/#79)。
#
# ファイル名は素の相対パスでは解決できない。cargo-embuildが生成する合成CMake
# プロジェクトの実体は target/ 配下の一時ディレクトリ
# (target/<triple>/<profile>/build/<pkg>/<fingerprint>/out)にあり、ESP-IDFの
# project.cmakeはそこを基準にCONFIG_PARTITION_TABLE_CUSTOM_FILENAMEを解決する
# (このプロジェクトのfirmware/ディレクトリではない)。つまり`..`の段数は
# out/からcrateディレクトリまでの深さであり、cargoのbuild dir構成で変わる:
#   旧構成 build/esp-idf-sys-<fp>/out …… 6段でfirmware/へ届く(現行esp toolchain)
#   新構成 build/esp-idf-sys/<fp>/out …… 1段深く7段必要になる(Issue #213)
# Kconfigの$(VAR)展開で絶対パスにする案は、$(PROJECT_DIR)がこの経路では展開
# されずリテラルのままparttool.pyへ届くため使えない(実ビルドで確認、Issue #213)。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../partitions.csv"
# OTA後、起動自己診断を通過するまで新slotをcommitしない運用にする(esp_ota_mark_app_*)。
# 未commitのままM5Stackが再起動するとbootloaderが自動的に旧slotへ戻る。診断ロジック自体は
# Phase4(#79)で実装する。この設定はPhase1の時点で有効にしておく
# (otadata partitionの追加とセットのbootloader機能であり、後から追加すると
# もう一度パーティション構成に触るbootloaderの再書き込みが必要になるため)。
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
