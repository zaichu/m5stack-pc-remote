  "cards": [
    { "dot": "rose", "title": "セキュリティ", "items": [
      "REBOOT/SHUTDOWNはHMAC-SHA256署名 + timestamp（±60秒許容）+ 使い捨てnonceが必須",
      "TelegramのTLSルートCAをピン留め（telegram_root_ca.rsにハードコード）",
      "TelegramコマンドはTELEGRAM_ALLOWED_USER_IDのfrom.idのみ受理",
      "dry_runは既定でtrue。明示的に無効化しない限り実行しない"
    ] },
    { "dot": "amber", "title": "失敗・復旧経路", "items": [
      "未許可ユーザー・不正/期限切れのtimestamp・nonce再利用: リクエストを無視し実行しない",
      "m5stack-pc-bridgeクラッシュ時: Windows Service Recoveryが自動再起動",
      "M5StackのWi-Fi切断は15秒ごとに再接続。Telegram取得失敗は5〜60秒でbackoff"
    ] },
    { "dot": "cyan", "title": "秘密情報の境界", "items": [
      "BRIDGE_SHARED_SECRET: M5Stackとm5stack-pc-bridgeのみが保持",
      "TELEGRAM_BOT_TOKEN: M5StackとTelegramのみが保持し、bridgeへは転送しない"
    ] }
  ]
